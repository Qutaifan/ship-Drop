# Copy to .env on the host that runs the stack. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=medusa
DATABASE_URL=postgres://medusa:change-me-long-random@postgres:5432/medusa

# --- Valkey (Redis-compatible) ---
REDIS_URL=redis://valkey:6379

# --- Medusa ---
# Generate each with: openssl rand -base64 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me
MEDUSA_BACKEND_URL=https://api.example.com
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://admin.example.com
AUTH_CORS=https://shop.example.com,https://admin.example.com

# --- Storefront ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_BASE_URL=https://shop.example.com

# --- Firecrawl (self-hosted; run on hq-2, not beside the storefront) ---
FIRECRAWL_API_URL=http://localhost:3002
