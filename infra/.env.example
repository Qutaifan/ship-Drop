# Copy to .env on the host that runs the stack. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=medusa
DATABASE_URL=postgres://medusa:***@postgres:5432/medusa

# --- Valkey (Redis-compatible) ---
REDIS_URL=redis://valkey:6379

# --- Medusa ---
# Generate each with: openssl rand -base64 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me
MEDUSA_BACKEND_URL=https://api.yourdomain.com
STORE_CORS=https://shop.yourdomain.com
ADMIN_CORS=https://admin.yourdomain.com
AUTH_CORS=https://shop.yourdomain.com,https://admin.yourdomain.com

# --- Storefront ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.yourdomain.com
NEXT_PUBLIC_BASE_URL=https://shop.yourdomain.com

# --- Umami (self-hosted analytics) ---
# Generate with: openssl rand -base64 32
UMAMI_HASH_SALT=change-me

# --- Listmonk (self-hosted email) ---
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=change-me-long-random

# --- Cloudflare R2 (Object storage) ---
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=hermes-ecom-media
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=cdn.yourdomain.com

# --- Firecrawl (self-hosted; run on hq-2, not beside the storefront) ---
FIRECRAWL_API_URL=http://localhost:3002