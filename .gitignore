# Secrets — never commit
.env
*.env
!.env.example
infra/.env

# Working artifacts
_to_delete/
__pycache__/
*.pyc
.hermes-tmp*

# Database & runtime stores
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db
data/*.db-journal
data/verifications/*.json
data/audit/*.json
data/audit/*.jsonl
data/signals/*.json
data/supplier_health/*.json
data/telemetry/*.json
data/archives/
data/medusa_drafts/

# Large raw API dumps (regenerable; keep the analysed reports, not the payloads)
reports/*-raw.txt
reports/cj-direct-token-*.json

# Vendored third-party skill library (nexscope-ai/eCommerce-Skills, MIT).
# Has its own .git, so git records it as a bare gitlink with no .gitmodules —
# a broken submodule that clones as an empty directory. Keep it out of the repo.
eCommerce-Skills/
