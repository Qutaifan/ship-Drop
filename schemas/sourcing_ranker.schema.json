{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dropship.local/schemas/sourcing_ranker.schema.json",
  "title": "Hermes Sourcing Agent Supplier Ranking & Prioritization Matrix",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "ranked_at",
    "evaluation_market",
    "primary_ranking_metric",
    "suppliers",
    "selected_supplier_id"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "ranked_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation_market": {
      "type": "string",
      "enum": ["US", "EU"]
    },
    "primary_ranking_metric": {
      "type": "string",
      "enum": ["stability_score", "net_margin", "lead_time", "cogs_multiple"]
    },
    "suppliers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "supplier_id",
          "supplier_name",
          "stability_score",
          "actionability_score",
          "metrics",
          "tier",
          "canary_eligible"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "supplier_id": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "stability_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "actionability_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "landed_cost",
              "projected_net_margin",
              "cogs_multiple",
              "stock_level",
              "lead_days_max",
              "warehouse_country",
              "warehouse_type",
              "defect_rate_percent"
            ],
            "properties": {
              "landed_cost": {
                "type": "number",
                "minimum": 0
              },
              "projected_net_margin": {
                "type": "number"
              },
              "cogs_multiple": {
                "type": "number",
                "minimum": 0
              },
              "stock_level": {
                "type": "integer",
                "minimum": 0
              },
              "lead_days_max": {
                "type": "integer",
                "minimum": 1
              },
              "warehouse_country": {
                "type": "string"
              },
              "warehouse_type": {
                "type": "string",
                "enum": ["domestic", "international_transit"]
              },
              "defect_rate_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "tier": {
            "type": "string",
            "enum": [
              "PREFERRED_DOMESTIC",
              "QUALIFIED_BACKUP",
              "HIGH_RISK_MONITOR",
              "REJECTED_UNVIABLE"
            ]
          },
          "canary_eligible": {
            "type": "boolean"
          },
          "reconciliation_status": {
            "type": "string",
            "enum": ["MARGIN_STABLE", "MARGIN_COMPRESSED"]
          }
        }
      }
    },
    "selected_supplier_id": {
      "type": "string"
    },
    "recommended_allocation_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "ranking_notes": {
      "type": "string"
    }
  }
}
