{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dropship.local/schemas/supplier_verification.schema.json",
  "title": "Dropship Supplier Verification & Reality Audit",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "candidate_id",
    "supplier_id",
    "sku",
    "verified_at",
    "verified_at_unix",
    "stock_level",
    "warehouse_country",
    "warehouse_type",
    "shipping_method",
    "quoted_product_cost",
    "verified_product_cost",
    "quoted_shipping_cost",
    "verified_shipping_cost",
    "price_drift_percent",
    "duty_percent",
    "lead_days_min",
    "lead_days_max",
    "defect_rate_percent",
    "packaging_type",
    "verification_confidence",
    "stability_score",
    "status"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "default": "1.0.0"},
    "verification_id": {
      "type": "string",
      "pattern": "^ver-[0-9]{8}-[a-z0-9-]+$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "supplier_id": {
      "type": "string",
      "minLength": 1
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at_unix": {
      "type": "integer",
      "minimum": 0
    },
    "stock_level": {
      "type": "integer",
      "minimum": 0
    },
    "warehouse_country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "warehouse_type": {
      "type": "string",
      "enum": ["domestic", "international_transit", "bonded_hub"]
    },
    "warehouse_lat": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0
    },
    "warehouse_lon": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0
    },
    "shipping_method": {
      "type": "string",
      "enum": ["USPS", "UPS", "FedEx", "DHL", "EU DPD", "CN ePacket", "other"]
    },
    "quoted_product_cost": {
      "type": "number",
      "minimum": 0
    },
    "verified_product_cost": {
      "type": "number",
      "minimum": 0
    },
    "quoted_shipping_cost": {
      "type": "number",
      "minimum": 0
    },
    "verified_shipping_cost": {
      "type": "number",
      "minimum": 0
    },
    "price_drift_percent": {
      "type": "number"
    },
    "duty_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "lead_days_min": {
      "type": "integer",
      "minimum": 1
    },
    "lead_days_max": {
      "type": "integer",
      "minimum": 1
    },
    "defect_rate_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "packaging_type": {
      "type": "string",
      "enum": ["polybag", "custom_box", "bubble_mailer", "kraft_box"]
    },
    "verification_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "stability_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "type": "string",
      "enum": [
        "VERIFIED_PASS",
        "DRIFT_DETECTED",
        "OUT_OF_STOCK",
        "WAREHOUSE_MISMATCH",
        "API_SILENCE",
        "SKU_FRAGMENTATION"
      ]
    },
    "verification_notes": {
      "type": "string"
    },
    "hmac_signature": {
      "type": "string"
    }
  }
}
